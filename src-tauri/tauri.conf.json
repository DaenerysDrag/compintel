{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Compintel",
  "version": "0.2.0",
  "identifier": "com.nowgg.compintel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Compintel",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Compintel — competitive intelligence desktop app",
    "longDescription": "Compintel — desktop control panel that wraps the now.gg pipeline in a Jarvis-style UI for one-click runs, live progress, and centralized state.",
    "copyright": "© 2026 now.gg / BlueStacks",
    "publisher": "now.gg / BlueStacks",
    "homepage": "https://github.com/DaenerysDrag/compintel",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "docs.google.com"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
